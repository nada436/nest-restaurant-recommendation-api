# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# For local Docker development use the compose service name as host:
#   mongodb://admin:password@mongo:27017/restaurant_management?authSource=admin
# For MongoDB Atlas (production / staging):
#   mongodb+srv://<username>:<password>@cluster.mongodb.net/restaurant_management?retryWrites=true&w=majority
# ─────────────────────────────────────────────
MONGO_URI=mongodb://admin:password@mongo:27017/restaurant_management?authSource=admin

# ─────────────────────────────────────────────
# MongoDB container credentials
# (used by docker-compose.yml and docker-compose.prod.yml)
# ─────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password

# ─────────────────────────────────────────────
# Better Auth
# BETTER_AUTH_SECRET must be a long, random string (32+ chars)
# BETTER_AUTH_URL must match the public URL of the API
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret-32chars
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Docker / CI (not used at runtime — for reference only)
# DOCKER_IMAGE  : full image name pushed to GHCR
# IMAGE_TAG     : specific tag to deploy (defaults to "latest")
# DEPLOY_PATH   : absolute path on the production server where
#                 docker-compose.prod.yml lives
# DEPLOY_URL    : public URL shown in the GitHub Actions environment
# ─────────────────────────────────────────────
# DOCKER_IMAGE=ghcr.io/<your-github-username>/<repo-name>
# IMAGE_TAG=latest
# DEPLOY_PATH=/opt/restaurant-api
# DEPLOY_URL=https://api.yourdomain.com
